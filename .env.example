# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters

# Relative paths are resolved from the project root. Keep database and media on persistent disk.
DATABASE_URL=file:./data/portfolio.db
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
